# Ignore local Supabase CLI state and edge functions, but NOT migrations:
# RLS/security fixes only exist as reviewable artifacts if they are versioned.
# `supabase/*` excludes the directory contents; the negation re-includes the
# migrations folder (Git cannot un-ignore a path inside an ignored directory).
supabase/*
!supabase/migrations/
mockup-ui/
!supabase/migrations/153_warehouse_catalog.sql
