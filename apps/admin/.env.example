# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# hCaptcha (public site key — safe to expose to browser)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Payment QR (required). Comma-separated `normalized-platform-name:account-number`,
# e.g. `mbbank:0123456789`. Must match the storefront value; without it the admin
# Payment QR section fails closed instead of encoding an unapproved account.
PAYMENT_BANK_ALLOWLIST=
