{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mobile-noobstore",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mobile-noobstore"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "noobstore.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.noobstore.xyz",
      "custom_domain": true
    }
  ]
}
