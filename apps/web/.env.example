# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cookie domain for Supabase auth (".noobstore.xyz" in production). Widens the
# session cookie to every subdomain so a session survives the www <-> m. device
# redirect. Leave unset on localhost -> cookies stay host-scoped.
# The NEXT_PUBLIC_ prefix is required, not cosmetic: the browser client reads
# this value to set cookieOptions.domain, so Next must inline it at build time.
# NEXT_PUBLIC_COOKIE_DOMAIN=.noobstore.xyz

# Mobile subdomain split (desktop module) — keep "false" until the
# m.noobstore.xyz DNS record is live in Vercel, so all devices stay on the
# current host without redirects. Set to "true" once the subdomain exists.
# MOBILE_SUBDOMAIN_ENABLED=false

# Supabase — server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only receiving-account trust anchor. Match platform_name normalized to
# lowercase with spaces, underscores and hyphens removed, then :account_number.
# Missing/mismatched value disables payment instructions. Verify in store bank app.
# PAYMENT_BANK_ALLOWLIST=mbbank:0123456789

# Telegram bot — server-only
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Rate-limit warnings use TELEGRAM_CHAT_ID with this topic; other messages stay unchanged.
TELEGRAM_RATE_LIMIT_THREAD_ID=1303

# Redis (Upstash) — server-only
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Public base URL, used for the "view your order" link in email bodies.
NEXT_PUBLIC_APP_URL=https://www.noobstore.xyz

# Google OAuth — server-only
GOOGLE_CLIENT_ID=your-google-client-id
GA4_CLIENT_SECRET=your-google-client-secret
GA4_OAUTH_SCOPES=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# Google Analytics 4 — public measurement id (safe to expose to browser)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol — server-only (NEVER expose to browser)
# Create in GA4: Admin → Data Streams → Measurement Protocol API secrets
GA4_MP_API_SECRET=your-ga4-mp-api-secret

# Tracking — 3rd-party analytics (Google Analytics 4). Enabled by default,
# so only set it to "false" to fully opt out. Tracking is additionally never
# sent from dev/stg (Vercel preview) environments.
# NEXT_PUBLIC_TRACKING_ENABLED=true

# hCaptcha — public site key (safe to expose to browser)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
# HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Better Stack (Uptime) — server-only (API token from Uptime → Settings → API token)
BETTERSTACK_TOKEN=your-betterstack-token
# Email used as the incident requester (any verified account email works)
BETTERSTACK_REQUESTER_EMAIL=you@example.com

# Better Stack Real User Monitoring (RUM) — public flag; set to "true" to load the RUM snippet
# NEXT_PUBLIC_BETTERSTACK_RUM=true
# NEXT_PUBLIC_BETTERSTACK_RUM_TOKEN=your-betterstack-rum-token

# Public Vietnamese service status page URL. Leave unset until the page's
# custom domain and TLS have been verified; the storefront footer link is hidden otherwise.
# NEXT_PUBLIC_STATUS_PAGE_URL=https://status.noobstore.xyz

# Vercel Outgoing Webhook secret (for signature verification)
# VERCEL_WEBHOOK_SECRET=your-webhook-secret
