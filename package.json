{
	"name": "m-noobstore",
	"private": true,
	"packageManager": "yarn@4.3.1",
	"engines": {
		"node": ">=24.22.1 <25"
	},
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev:web": "turbo dev --filter=\"./apps/web\"",
		"dev:admin": "turbo dev --filter=\"./apps/admin\"",
		"lint": "turbo lint",
		"type-check": "turbo type-check",
		"check:admin-auth": "node scripts/verify-admin-auth.mjs",
		"test:unit": "vitest run -c apps/web/vitest.config.mts",
		"test:e2e": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
		"test:e2e:debug": "playwright test --debug --config=e2e/playwright.config.ts",
		"deploy:log": "bash scripts/add-deployment.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"dotenv": "^17.4.2",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"supabase": "2.98.1",
		"turbo": "^2.1.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.0",
		"motion": "^12.38.0",
		"xlsx": "^0.18.5"
	}
}
