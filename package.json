		"type-check": "turbo type-check"
	},
	"devDependencies": {
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.1.3"
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.0",
		"motion": "^12.38.0",
		"supabase": "2.98.1",
		"xlsx": "^0.18.5"
	}
}
