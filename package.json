{
	"name": "m-noobstore",
	"private": true,
	"packageManager": "yarn@4.3.1",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev:web": "turbo dev --filter=\"./apps/web\"",
