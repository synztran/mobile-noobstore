{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "ADMIN_APP_ORIGIN",
        "BETTERSTACK_REQUESTER_EMAIL",
        "BETTERSTACK_TOKEN",
        "CHANGEDETECTION_API_KEY",
        "CHANGEDETECTION_BASE_URL",
        "CHANGEDETECTION_WEBHOOK_URL",
        "CRAWLING_WEBHOOK_SECRET",
        "CRON_SECRET",
        "DISTANCE_INCLUDED_KM",
        "DISTANCE_PER_KM",
        "FB_APP_ID",
        "FB_APP_SECRET",
        "GA4_CLIENT_SECRET",
        "GA4_MP_API_SECRET",
        "GA4_OAUTH_SCOPES",
        "GOOGLE_BUSINESS_ACCOUNT_ID",
        "GOOGLE_BUSINESS_API_KEY",
        "GOOGLE_BUSINESS_LOCATION_ID",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_DISTANCE_MATRIX_API_KEY",
        "GOONG_API_KEY",
        "INVOICE_API_KEY",
        "MOBILE_SUBDOMAIN_ENABLED",
        "NOMINATIM_USER_AGENT",
        "NOTIFICATION_INTERNAL_SECRET",
        "PAYMENT_BANK_ALLOWLIST",
        "PUBLIC_GOOGLE_DISTANCE_MATRIX_API_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "STORE_ADDRESS",
        "STORE_LAT",
        "STORE_LON",
        "SUPABASE_SERVICE_ROLE_KEY",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "TELEGRAM_RATE_LIMIT_THREAD_ID",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "VERCEL_URL",
        "VERCEL_WEBHOOK_SECRET",
        "WEB_APP_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    }
  }
}
